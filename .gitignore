# Real data and generated reports never leave this machine
data/input/
data/output/*
data/extract/
data/jobs/
data/weekly/
!data/output/.gitkeep
*.csv
!config/examples/*.csv
!tests/fixtures/*.csv
!tests/golden/*.csv
!tests/golden/lines/*.csv
*.xlsx
*.pdf
*Zone.Identifier

# Local environment
.env

# The business config is private (CONFIG_DIR, docs/architecture.md); examples/ is the demo
config/*
!config/examples/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Moka API extraction: tokens, raw API responses and schema dumps stay local
extraction/moka/.token.json*
extraction/moka/output/

# Written into the workspace by google-github-actions/auth
gha-creds-*.json
