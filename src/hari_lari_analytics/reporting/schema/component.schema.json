                      "avg_item_price",
                      "category_aov",
                      "contributive_aov",
                      "discount_rate",
                      "discounts",
                      "drink_attach_rate",
                      "drink_orders",
                      "first_sale_ts",
                      "food_and_drink_orders",
                      "food_attach_rate",
                      "food_orders",
                      "gross_sales",
