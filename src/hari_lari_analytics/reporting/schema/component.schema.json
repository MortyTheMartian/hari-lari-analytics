      "additionalProperties": false,
      "properties": {
        "by": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "adjusted_category",
                    "adjusted_item",
                    "adjusted_item_variant",
                    "basket_size",
                    "bucket",
                    "category",
                    "category_group_level_1",
                    "category_group_level_2",
                    "discount_code",
                    "discounted",
                    "event_kind",
                    "event_name",
                    "has_consignment",
                    "has_discount",
                    "has_drink",
                    "has_food",
                    "has_modifier",
                    "has_promotion",
                    "has_refund",
                    "hour_of_day",
                    "is_holiday",
                    "is_refund",
                    "item",
                    "item_variant",
                    "modifier_name",
                    "modifier_option_name",
                    "order_line_count",
                    "payment_type",
                    "sale_date",
                    "sale_hour",
                    "sale_iso_week",
                    "sale_month",
                    "sale_quarter",
                    "sale_week",
                    "sale_year",
                    "variant",
                    "weekday"
                  ],
                  "description": "a dimension of dimensions.yml"
                },
                {
                  "enum": [
                    "period",
                    "metric"
                  ]
                }
              ],
              "description": "a dimension, period or metric"
            },
            {
              "type": "string",
              "pattern": "^\\$([a-z_][a-z0-9_]*)$",
              "description": "a parameter"
            }
          ]
        },
        "values": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "const": "all",
                  "type": "string"
                },
                {
                  "items": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": "array"
                },
                {
                  "$ref": "#/$defs/TopValues"
                }
              ],
              "default": "all",
              "title": "Values"
            },
            {
              "type": "string",
              "pattern": "^\\$([a-z_][a-z0-9_]*)$",
              "description": "a parameter"
