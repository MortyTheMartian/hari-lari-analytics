      "required": [
        "model",
        "metrics",
        "window"
      ],
      "title": "Query",
      "type": "object"
    },
    "SourceQuery": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "lines_export",
                "notes"
