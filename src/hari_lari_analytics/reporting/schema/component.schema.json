    "transforms": {
      "default": [],
      "items": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "classify",
              "cumulative_share",
              "decompose",
              "fill_domain",
              "growth_vs_previous",
              "per_trading_day",
              "pivot",
              "rank",
              "sort_limit",
              "suppress_small_n"
            ],
            "description": "a transform without options"
          },
          {
            "type": "object",
            "description": "Add a class column: thresholds on a column (ABC classes), quadrants of two columns against",
            "properties": {
              "classify": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "description": "`mode: thresholds` needs `by`, `bands` and `otherwise`; `quadrants` needs `x` and `y`;\n`lifecycle` needs `by`. Options of another mode are refused.",
